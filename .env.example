# ── Model ─────────────────────────────────────────────────────────
MODEL_PATH=models/lgbm_fraud_ref.pkl
MODEL_VERSION=0.1.0

# ── Data Layout ───────────────────────────────────────────────────
RAW_DATA_DIR=data/raw
REFERENCE_PATH=data/reference/reference_window.csv
INCOMING_DIR=data/incoming
REPORTS_DIR=reports

# ── Temporal Split ────────────────────────────────────────────────
# Day offsets within TransactionDT. Confirm span in Phase 0 before trusting these.
REFERENCE_DAYS=60
BATCH_DAYS=30

# ── Drift Detectors ───────────────────────────────────────────────
PSI_THRESHOLD=0.20
MMD_ALPHA=0.05
MMD_SUBSAMPLE=2000
MMD_PERMUTATIONS=500
KS_COUNT_THRESHOLD=3
VOTE_THRESHOLD=2

# ── Evaluation ────────────────────────────────────────────────────
# Degradation threshold for alert scoring. Fixed in Phase A, before detectors run.
DEGRADATION_DELTA=0.05
DEGRADATION_MODE=absolute    # absolute | relative

# ── Reproducibility ───────────────────────────────────────────────
# Seeds every stochastic step: MMD subsample, permutation test, LightGBM, drift injection.
RANDOM_SEED=42

# ── Stretch: deployment layer (not built — see resource.md) ───────
# DB_PATH=data/predictions.db
