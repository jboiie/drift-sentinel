# ── Required ──────────────────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Agent ─────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-3.5-flash-lite
# Free-tier pacing between agent calls. Set to 0 on a paid tier.
GEMINI_MIN_INTERVAL_SECONDS=4.5

# ── Judge (RAGAS Faithfulness + self-consistency) ────────────────
GROQ_JUDGE_MODEL=openai/gpt-oss-20b
